# ── nvim ──────────────────────────────────────────────────────────────────────
nvim/.config/nvim/tags
nvim/.config/nvim/test.sh
nvim/.config/nvim/.luarc.json
nvim/.config/nvim/nvim
nvim/.config/nvim/spell/
# Intentionally ignored to avoid merge conflicts with upstream kickstart.nvim
nvim/.config/nvim/nvim-pack-lock.json

# ── tmux ──────────────────────────────────────────────────────────────────────
tmux/.config/tmux/plugins/

# ── zsh ───────────────────────────────────────────────────────────────────────
zsh/.config/zsh/plugins/
zsh/.config/zsh/.zcompdump

# ── claude ────────────────────────────────────────────────────────────────────
# ~/.claude mixes config with runtime state (sessions, history, credentials,
# caches, installed plugins). Deny everything, then re-allow the config bits.
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/CLAUDE.md
!claude/.claude/agents/
!claude/.claude/commands/
!claude/.claude/skills/
!claude/.claude/hooks/
!claude/.claude/output-styles/
# Machine-local overrides are meant to stay untracked
claude/.claude/settings.local.json

# ── misc ──────────────────────────────────────────────────────────────────────
.DS_Store
